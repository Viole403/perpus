+    $mixSubject = preg_replace('/^\d+\s*-\s*/', '', (string) ($mixRow['namakelas'] ?? ''));
+    $mix_labels[] = ['kode' => $mixKode, 'label' => trim($mixRange . ' ' . $mixSubject)];
+}
+$mix_labels_json = json_encode($mix_labels, JSON_UNESCAPED_UNICODE);
