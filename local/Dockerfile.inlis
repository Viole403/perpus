FROM docker.io/library/php:8.2-apache

RUN apt-get update \
    && apt-get install -y libicu-dev libxml2-dev libzip-dev libpng-dev libonig-dev libjpeg62-turbo libjpeg62-turbo-dev libfreetype6-dev git unzip \
    && docker-php-ext-install intl xml xmlwriter mbstring zip mysqli pdo_mysql \
    && docker-php-ext-enable intl xml xmlwriter mbstring zip mysqli pdo_mysql \
    && docker-php-ext-install -j$(nproc) iconv \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd \
    && docker-php-ext-enable gd \
    && rm -rf /var/lib/apt/lists/*

RUN a2enmod rewrite
RUN sed -i 's|DocumentRoot /var/www/html|DocumentRoot /var/www/html/public|' /etc/apache2/sites-available/000-default.conf

COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Vendor disalin dari bundle Laragon (composer.json identik).
# Tanpa composer install di build: hemat download ~500MB.
COPY INLISLIteV33/ /var/www/html/

RUN rm -rf /var/www/html/.git \
    && test -f /var/www/html/vendor/autoload.php \
    && chown -R www-data:www-data /var/www/html/writable

EXPOSE 80

CMD ["apache2-foreground"]
